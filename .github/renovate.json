{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "jenkins": {
    "enabled": true
  },
  "flux": {
    "managerFilePatterns": ["/^apps/gcp/acr-runners/.*\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["apps/.*/jenkins.*/release/.*-plugins\\.yaml$$"],
      "matchStrings": [
        "datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s.*: (?<currentValue>.*)\\s",
        "datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s.*: .*/download/(?<currentValue>[^/]+)/[^/]+\\.\\w+\\s"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}maven{{/if}}"
    },
    {
      "customType": "regex",
      "fileMatch": ["apps/.*\\.yaml$$"],
      "matchStrings": [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: registryUrl=(?<registryUrl>\\S+))?[\\s\\S]*?(?:tag|version|appVersion): (?<currentValue>\\S+)(?:\\s|$)",
        "(?:tag|version|appVersion): (?<currentValue>\\S+)[\\s\\S]*?datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: registryUrl=(?<registryUrl>\\S+))?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{/if}}"
    },
    {
      "customType": "regex",
      "fileMatch": ["apps/gcp/prow/release/release\\.yaml$$"],
      "matchStrings": [
        "repository:\\s*(?<depName>[^\\s]+)[\\s\\S]*?tag:\\s*(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Disable Flux system updates for prod2 only",
      "matchManagers": ["flux"],
      "matchFileNames": [
        "clusters/prod2/flux-system/gotk-components.yaml"
      ],
      "enabled": false
    },
    {
      "description": "Open GCP ARC upgrade PRs during normal Renovate runs",
      "matchManagers": ["flux"],
      "matchFileNames": ["apps/gcp/acr-runners/**"],
      "enabled": true,
      "schedule": ["at any time"],
      "dependencyDashboardApproval": false,
      "automerge": false,
      "ignoreUnstable": true
    },
    {
      "description": "Upgrade the GCP ARC controller and runner scale-set charts together",
      "matchManagers": ["flux"],
      "matchFileNames": ["apps/gcp/acr-runners/**"],
      "matchDepTypes": ["HelmChart"],
      "groupName": "GCP Actions Runner Controller charts",
      "groupSlug": "gcp-arc-charts"
    },
    {
      "description": "Keep the GCP Actions runner image pinned when updating its tag or digest",
      "matchManagers": ["flux"],
      "matchFileNames": ["apps/gcp/acr-runners/**"],
      "matchPackageNames": ["ghcr.io/actions/actions-runner"],
      "pinDigests": true
    }
  ]
}
