          },
          "title": "Development builds",
          "type": "list"
        },
        {
          "dynamicOptions": [
            {
              "field": "product",
              "itemsPointer": "/products",
              "labelPointer": "/label",
              "request": {
                "dataSource": "tibuild",
                "method": "GET",
                "path": "/devbuilds/capabilities"
              },
              "valuePointer": "/id"
            }
          ],
          "id": "new-build",
          "module": "tibuild",
          "route": "/tibuild/builds/new",
          "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "properties": {
              "gitRef": {
                "description": "Use branch/\u003cname\u003e, tag/\u003cname\u003e, pull/\u003cnumber\u003e, commit/\u003c40-char SHA\u003e, or a full 40-char SHA.",
                "minLength": 1,
                "pattern": "^(branch/.+|tag/.+|pull/[0-9]+|commit/[0-9a-fA-F]{40}|[0-9a-fA-F]{40})$",
                "title": "Git ref",
                "type": "string"
              },
              "platform": {
                "default": "linux",
                "oneOf": [
                  {
                    "const": "linux",
                    "title": "Linux — amd64 + arm64"
                  },
                  {
                    "const": "linux/amd64",
                    "title": "Linux — amd64"
                  },
                  {
                    "const": "linux/arm64",
                    "title": "Linux — arm64"
                  }
                ],
                "title": "Platform",
                "type": "string"
              },
              "product": {
                "description": "Component to build.",
                "title": "Product",
                "type": "string"
              }
            },
            "required": [
              "product",
              "gitRef",
              "platform"
            ],
            "type": "object"
          },
          "submit": {
            "label": "Start build",
            "request": {
              "body": {
                "request": {
                  "edition": {
                    "const": "community"
                  },
                  "gitRef": {
                    "from": "form",
                    "pointer": "/gitRef"
                  },
                  "pipelineEngine": {
                    "const": "tekton"
                  },
                  "platform": {
                    "from": "form",
                    "pointer": "/platform"
                  },
                  "product": {
                    "from": "form",
                    "pointer": "/product"
                  }
                }
              },
              "dataSource": "tibuild",
              "method": "POST",
              "path": "/devbuilds"
            },
            "resultIDPointer": "/id",
            "successNavigate": "/tibuild/builds/{id}"
          },
          "title": "New development build",
          "type": "form",
          "uiSchema": {
            "gitRef": {
              "ui:placeholder": "branch/master"
            },
            "product": {
              "ui:placeholder": "Select a product"
            },
            "ui:submitButtonOptions": {
              "norender": true
            }
          }
        }
