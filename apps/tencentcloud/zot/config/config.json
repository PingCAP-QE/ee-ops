{
  "log": { "level": "debug" },
  "storage": {
    "rootDirectory": "/var/lib/registry",
    "remoteCache": true,
    "commit": true,
    "dedupe": true,
    "gc": true,
    "gcDelay": "1h",
    "gcInterval": "1h",
    "storageDriver": {
      "name": "s3",
      "rootdirectory": "/",
      "secure": true,
      "skipverify": false,
      "forcepathstyle": false,
      "region": "${S3_REGION}",
      "regionendpoint": "${S3_REGION_ENDPOINT}",
      "bucket": "${S3_BUCKET}",
      "accesskey": "${S3_ACCESS_KEY}",
      "secretkey": "${S3_SECRET_KEY}"
    },
    "cacheDriver": {
      "name": "redis",
      "url": "redis://:${REDIS_PASSWORD}@redis-master:6379/0?dial_timeout=3&read_timeout=6s",
      "keyprefix": "zot"
    },
    "retention": {
      "policies": [
        {
          "repositories": ["ttl-1h/**"],
          "keepTags": [{ "patterns": [".*"], "pushedWithin": "1h" }]
        },
        {
          "repositories": ["ttl-1d/**"],
          "keepTags": [{ "patterns": [".*"], "pushedWithin": "24h" }]
        },
        {
          "repositories": ["ttl-1w/**"],
          "keepTags": [{ "patterns": [".*"], "pushedWithin": "168h" }]
        }
      ]
    }
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "compat": ["docker2s2"],
    "externalUrl": "${EXTERNAL_URL}",
    "realm": "zot",
    "readTimeout": "600s",
    "writeTimeout": "600s",
    "auth": {
      "failDelay": 5,
      "htpasswd": {
        "path": "/secret/htpasswd"
      },
      "sessionKeysFile": "/secret/sessionKeys.json",
      "apikey": true,
      "openid": {
        "providers": {
          "google": {
            "issuer": "https://accounts.google.com",
            "clientid": "${GOOGLE_CLIENT_ID}",
            "clientsecret": "${GOOGLE_CLIENT_SECRET}",
            "scopes": ["openid", "email"]
          }
        }
      }
    },
    "accessControl": {
      "groups": {
        "pullers": {
          "users": ["ci-bot"]
        },
        "pushers": {
          "users": ["cd-bot"]
        },
        "personal": {
          "users": ${PERSONAL_USERS}
        }
      },
      "repositories": {
        "personal/**": {
          "policies": [
            {
              "groups": ["personal"],
              "actions": ["read", "create", "update", "delete"],
              "conditions": [
                {
                  "expression": "req.repository.startsWith('personal/' + req.user.username.split('@')[0] + '/')",
                  "message": "only your personal namespace"
                }
              ]
            }
          ],
          "anonymousPolicy": [],
          "defaultPolicy": ["read"]
        },
        "ttl-1h/**": {
          "anonymousPolicy": ["read"],
          "defaultPolicy": ["read", "create", "update"]
        },
        "ttl-1d/**": {
          "anonymousPolicy": ["read"],
          "defaultPolicy": ["read", "create", "update"]
        },
        "ttl-1w/**": {
          "anonymousPolicy": ["read"],
          "defaultPolicy": ["read", "create", "update"]
        },
        "**": {
          "policies": [
            {
              "groups": ["pullers"],
              "actions": ["read"]
            },
            {
              "groups": ["pushers"],
              "actions": ["read", "create", "update"]
            }
          ],
          "anonymousPolicy": [],
          "defaultPolicy": ["read"]
        }
      },
      "adminPolicy": {
        "users": ["admin", "wuhui.zuo@pingcap.com"],
        "actions": ["read", "create", "update", "delete"]
      }
    },
    "ratelimit": {
      "rate": 100,
      "methods": [
        {
          "method": "GET",
          "rate": 50
        }
      ]
    }
  },
  "extensions": {
    "ui": {
      "enable": true
    },
    "search": {
      "enable": true
    },
    "sync": {
      "enable": true,
      "downloadDir": "/tmp/zot",
      "credentialsFile": "${ZOT_SYNC_AUTH_JSON_FILEPATH}",
      "registries": [
        {
          "urls": ["https://us-docker.pkg.dev"],
          "preserveDigest": true,
          "content": [
            {
              "prefix": "/pingcap-testing-account/dev/**",
              "destination": "/mirrors/dev",
              "stripPrefix": true
            },
            {
              "prefix": "/pingcap-testing-account/tidbx/**",
              "destination": "/mirrors/tidbx",
              "stripPrefix": true
            },
            {
              "prefix": "/pingcap-testing-account/hub/**",
              "destination": "/mirrors/hub",
              "stripPrefix": true
            },
            {
              "prefix": "/pingcap-testing-account/internal/**",
              "destination": "/mirrors/internal",
              "stripPrefix": true
            }
          ],
          "onDemand": true,
          "tlsVerify": true
        },
        {
          "urls": ["https://ghcr.io"],
          "preserveDigest": true,
          "content": [
            {
              "prefix": "**",
              "destination": "/mirrors/ghcr"
            }
          ],
          "onDemand": true,
          "tlsVerify": true
        }
      ]
    },
    "scrub": {
      "enable": true,
      "interval": "120h"
    },
    "mgmt": {
      "enable": true
    }
  }
}
